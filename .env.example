# Personalizēts balss aģents: environment variables
# Copy to .env.local and fill in. Never commit real values. Never prefix secrets with NEXT_PUBLIC_.

# --- OpenAI (text chat + real voice via Realtime API) ---
# Server-only. Without it, the app runs in a scripted demo fallback (clearly labeled in the UI).
OPENAI_API_KEY=

# Text chat model (optional override)
OPENAI_TEXT_MODEL=gpt-4o-mini

# Realtime voice model + a MALE voice id (verify against current OpenAI docs before changing)
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=ash
# Transcribes the user's speech so it appears in the chat
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe

# --- Neon PostgreSQL (optional) ---
# Server-only. Without it, the app uses browser-local demo mode (clearly labeled).
DATABASE_URL=

# --- Google Calendar (read-only availability) ---
# Create a Google OAuth 2.0 Web application and enable the Calendar API.
# Register this callback locally: http://localhost:3000/api/google-calendar/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google-calendar/callback
# Long random server-only value used to encrypt OAuth tokens in an HttpOnly cookie.
GOOGLE_TOKEN_ENCRYPTION_KEY=

# --- Demo config (optional, safe to expose) ---
NEXT_PUBLIC_DEMO_CITY=Riga
NEXT_PUBLIC_PRODUCT_NAME=Personalizēts balss aģents
